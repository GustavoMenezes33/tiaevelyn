# --- Telegram ---
TELEGRAM_BOT_TOKEN=
# IDs numéricos autorizados, separados por vírgula
TELEGRAM_ALLOWED_USER_IDS=

# --- LLM ---
# Provedor principal: gemini | deepseek | groq | anthropic
LLM_PROVIDER=gemini
# Provedores de fallback (ordem de tentativa), separados por vírgula
LLM_FALLBACK_PROVIDERS=deepseek
# Provedor usado pelo SkillRouter (vazio = mesmo do LLM_PROVIDER)
ROUTER_PROVIDER=

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
# Esforço de raciocínio do Claude: low | medium | high
ANTHROPIC_EFFORT=medium

# --- Agent Loop ---
MAX_ITERATIONS=5
LLM_TIMEOUT_MS=120000

# --- Memória ---
DB_PATH=./data/tiaevelyn.db
MEMORY_WINDOW_SIZE=20

# --- Skills ---
SKILLS_DIR=./.agents/skills

# --- Áudio (STT / TTS) ---
# Comando do Whisper local (ex.: "whisper" do pacote openai-whisper, requer ffmpeg)
WHISPER_COMMAND=whisper
WHISPER_MODEL=base
# Idioma (vazio = detecção automática)
WHISPER_LANGUAGE=
WHISPER_TIMEOUT_MS=60000
TTS_VOICE=pt-BR-ThalitaMultilingualNeural
# Voz usada se a principal falhar duas vezes seguidas (a Multilingual falha às vezes com NoAudioReceived)
TTS_FALLBACK_VOICE=pt-BR-FranciscaNeural
# Motor de TTS: "universal" (lib npm edge-tts-universal) ou "cli" (pip install -U edge-tts)
TTS_ENGINE=universal
TTS_CLI_COMMAND=edge-tts
TTS_TIMEOUT_MS=30000

# --- Diretórios ---
TMP_DIR=./tmp
